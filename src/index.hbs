<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{meta.page_title}}</title>
    <meta name="description" content="{{meta.description}}" />
    <meta name="theme-color" content="#fff9f4" />
    <link rel="canonical" href="{{canonical}}" />
    <link rel="icon" href="assets/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="assets/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content="{{canonical}}" />
    <meta property="og:site_name" content="{{brand.title}}" />
    <meta property="og:title" content="{{meta.page_title}}" />
    <meta property="og:description" content="{{meta.description}}" />
    <meta property="og:image" content="{{og_image_full}}" />
    <meta property="og:image:alt" content="{{og.image_alt}}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{meta.page_title}}" />
    <meta name="twitter:description" content="{{meta.description}}" />
    <meta name="twitter:image" content="{{og_image_full}}" />
    <script type="application/ld+json">{{{jsonLd}}}</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Nunito+Sans:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="css/styles.css" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>

    <header class="site-header">
      <div class="header-inner wrap">
        <a class="btn-pill header-rdv" href="#contact">Prendre RDV</a>
        <div class="brand">
          <p class="brand__title">{{brand.title}}</p>
          <p class="brand__tag">{{brand.tag}}</p>
        </div>
        <div class="header-actions">
          <nav class="nav-desktop" aria-label="Navigation principale">
            <a href="#accueil">Accueil</a>
            <a href="#vision">Ma vision</a>
            <a href="#accompagnements">Accompagnements</a>
            <a href="#tarifs">Tarifs</a>
            <a href="#evenements">Événements &amp; ateliers</a>
            <a href="#contact">Contact</a>
            <a href="#faq">FAQ</a>
          </nav>
          <button
            type="button"
            class="menu-toggle"
            aria-expanded="false"
            aria-controls="nav-panel"
          >
            <span class="menu-toggle__label">Menu</span>
            <span class="menu-toggle__lines" aria-hidden="true">
              <span></span><span></span><span></span>
            </span>
          </button>
        </div>
      </div>
      <div class="nav-panel" id="nav-panel">
        <nav class="wrap" aria-label="Menu des sections">
          <a href="#accueil">Accueil</a>
          <a href="#vision">Ma vision</a>
          <a href="#accompagnements">Accompagnements</a>
          <a href="#tarifs">Tarifs</a>
          <a href="#evenements">Événements &amp; ateliers</a>
          <a href="#contact">Contact</a>
          <a href="#faq">FAQ</a>
        </nav>
      </div>
    </header>

    <main id="contenu">
      <section class="hero" id="accueil" aria-labelledby="hero-title">
        <div class="wrap hero-grid">
          <div class="hero__text">
            <p class="kicker">{{hero.kicker}}</p>
            <h1 id="hero-title">{{hero.title}}</h1>
            <p class="lead">{{hero.lead}}</p>
            <a class="btn-pill btn-pill--solid" href="#contact">Prendre RDV</a>
          </div>
          <div class="hero__visual">
            <img
              class="hero__img"
              src="{{hero.image}}"
              width="900"
              height="1200"
              alt="{{hero.image_alt}}"
            />
          </div>
        </div>
      </section>

      <section class="vision" id="vision" aria-labelledby="vision-title">
        <div class="wrap vision-grid">
          <div class="vision__deco" aria-hidden="true">
            <img src="{{vision.image}}" width="500" height="650" alt="" />
          </div>
          <div class="vision__text">
            <p class="kicker">{{vision.kicker}}</p>
            <h2 id="vision-title">{{vision.title}}</h2>
            <p class="lead">{{vision.lead}}</p>
            <a class="btn-pill" href="{{vision.button_href}}">{{vision.button_text}}</a>
          </div>
        </div>
      </section>

      <section class="services" id="accompagnements" aria-labelledby="services-title">
        <div class="wrap">
          <header class="section-head">
            <p class="kicker">{{services.kicker}}</p>
            <h2 id="services-title">{{services.title}}</h2>
            <p>{{services.intro}}</p>
          </header>
          <div class="cards-4">
            {{#each services.cards}}
            <article class="card">
              <img class="card__img" src="{{image}}" width="600" height="450" alt="{{image_alt}}" />
              <div class="card__body">
                <h3>{{title}}</h3>
                <p>{{text}}</p>
                <a class="link-arrow" href="{{link_href}}">{{link_text}}</a>
              </div>
            </article>
            {{/each}}
          </div>
        </div>
      </section>

      <section class="tarifs" id="tarifs" aria-labelledby="tarifs-title">
        <div class="wrap">
          <div class="tarifs__box">
            <div class="tarifs-grid">
              <div class="tarifs__intro">
                <p class="kicker">{{tarifs.kicker}}</p>
                <h2 id="tarifs-title">{{tarifs.title}}</h2>
                <p class="lead">{{tarifs.lead}}</p>
                <a class="btn-pill btn-pill--solid mt-btn" href="#contact">Prendre RDV</a>
              </div>
              <div class="price-cards">
                {{#each tarifs.prices}}
                <div class="price-card">
                  <p class="price-card__label">{{label}}</p>
                  <p class="price-card__amount">{{{amount}}}</p>
                  <p class="price-card__detail">{{{detail}}}</p>
                </div>
                {{/each}}
              </div>
            </div>
            <p class="tarifs-note">{{tarifs.note}}</p>
          </div>
        </div>
      </section>

      <section class="events" id="evenements" aria-labelledby="events-title">
        <div class="wrap events-grid">
          <div class="events__side">
            <p class="kicker">{{events.kicker}}</p>
            <h2 id="events-title">{{events.title}}</h2>
            <p class="lead">{{events.lead}}</p>
            <a class="btn-pill" href="{{events.button_href}}">{{events.button_text}}</a>
          </div>
          <div class="cards-3">
            {{#each events.cards}}
            <article class="event-card">
              <img class="event-card__img" src="{{image}}" width="600" height="375" alt="" />
              <div class="event-card__body">
                <p class="event-card__meta">{{{meta}}}</p>
                <h3>{{title}}</h3>
                <p>{{text}}</p>
                <a class="link-arrow" href="{{link_href}}">{{link_text}}</a>
              </div>
            </article>
            {{/each}}
          </div>
        </div>
      </section>

      <section class="contact-faq" id="contact" aria-labelledby="contact-title">
        <div class="wrap cf-grid">
          <div class="contact-block">
            <p class="kicker">{{contact.kicker}}</p>
            <h2 id="contact-title">{{contact.title}}</h2>
            <ul class="contact-list">
              <li>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                  <polyline points="22,6 12,13 2,6" />
                </svg>
                <a href="mailto:{{contact.email}}">{{contact.email}}</a>
              </li>
              <li>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                </svg>
                <a href="{{contact.instagram_url}}" rel="noopener noreferrer">{{contact.instagram_label}}</a>
              </li>
              <li>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
                <span>{{contact.location}}</span>
              </li>
            </ul>
            <a class="btn-pill btn-pill--solid" href="#contact">Prendre RDV</a>

            <!-- Web3Forms : clé sur https://web3forms.com — l’URL de redirection vers merci.html est remplie automatiquement une fois le site en ligne (http/https). -->
            <form
              class="form-stack"
              action="https://api.web3forms.com/submit"
              method="POST"
            >
              <input type="hidden" name="access_key" value="4aefa2d1-4905-4829-a350-c2c243cc6c68" />
              <input type="hidden" name="subject" value="{{form.subject}}" />
              <input type="hidden" name="from_name" value="{{form.from_name}}" />
              <input type="hidden" name="redirect" id="web3forms-redirect" value="" />
              <input
                type="checkbox"
                name="botcheck"
                class="form-honeypot"
                tabindex="-1"
                autocomplete="off"
                aria-hidden="true"
              />
              <label>
                Nom
                <input type="text" name="name" autocomplete="name" required />
              </label>
              <label>
                Email
                <input type="email" name="email" autocomplete="email" required />
              </label>
              <label>
                Message
                <textarea name="message" required></textarea>
              </label>
              <button class="btn-pill btn-pill--solid" type="submit">Envoyer</button>
            </form>
            <p class="form-privacy-note">
              En envoyant ce formulaire, vous acceptez que les données saisies soient utilisées
              pour répondre à votre demande, conformément à notre
              <a href="confidentialite.html">politique de confidentialité</a>.
            </p>
            <script>
              (function () {
                var el = document.getElementById("web3forms-redirect");
                if (!el) return;
                try {
                  var u = new URL("merci.html", window.location.href).href;
                  if (/^https?:\/\//i.test(u)) el.value = u;
                } catch (_) {}
              })();
            </script>
          </div>

          <div class="faq-block" id="faq">
            <p class="kicker">FAQ</p>
            <h2>Questions fréquentes</h2>
            <div class="faq-list">
              {{#each faq}}
              <details class="faq-item">
                <summary>{{question}}</summary>
                <p>{{answer}}</p>
              </details>
              {{/each}}
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-brand brand">
          <p class="brand__title">{{brand.title}}</p>
          <p class="brand__tag">{{brand.tag}}</p>
        </div>
        <nav class="footer-links" aria-label="Liens légaux">
          <a href="mentions-legales.html">Mentions légales</a>
          <a href="confidentialite.html">Confidentialité</a>
          <a href="cgv.html">CGV</a>
        </nav>
        <div class="footer-social">
          <a href="{{contact.instagram_url}}" aria-label="Instagram" rel="noopener noreferrer">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
            </svg>
          </a>
          <a href="mailto:{{contact.email}}" aria-label="Email">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg>
          </a>
        </div>
      </div>
    </footer>

    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script src="js/main.js"></script>
  </body>
</html>
